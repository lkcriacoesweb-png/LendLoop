{
  "name": "lendloop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "workflows": "node scripts/build-workflows.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "format": "prettier --write app components convex lib scripts tests docs README.md package.json tsconfig.json next.config.ts proxy.ts vitest.config.ts compose.yaml compose.hosted.yaml",
    "check": "npm run typecheck && npm test && npm run check:secrets && npm run build"
  },
  "dependencies": {
    "@clerk/nextjs": "7.9.23",
    "convex": "1.49.0",
    "lucide-react": "1.66.0",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@edge-runtime/vm": "5.0.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "convex-test": "0.0.66",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "type": "module"
}
