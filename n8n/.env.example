# Copy to n8n/.env. Use separate random values; never commit this file.
N8N_ENCRYPTION_KEY=replace-with-a-unique-random-value-at-least-32-characters
AUTOMATION_OUTBOUND_SECRET=replace-with-the-same-outbound-secret-set-in-convex
AUTOMATION_INBOUND_SECRET=replace-with-the-same-inbound-secret-set-in-convex
CONVEX_SITE_URL=https://your-development-deployment.convex.site
WEBHOOK_URL=http://localhost:5678/
