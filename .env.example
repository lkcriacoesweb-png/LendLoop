# Next.js: copy to .env.local. Leave blank until accounts are configured.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CONVEX_URL=
# Set ONLY in the Convex dashboard / `npx convex env set`:
# CLERK_JWT_ISSUER_DOMAIN=https://your-dev-instance.clerk.accounts.dev
# N8N_WEBHOOK_URL=https://your-authorized-n8n-host/webhook/lendloop-events
# AUTOMATION_OUTBOUND_SECRET=<random 32+ character secret>
# AUTOMATION_INBOUND_SECRET=<different random 32+ character secret>
# ENABLE_DEMO_SEED=true  (development only; remove after seeding)
# Local UI preview is enabled only in development unless explicitly opted in:
LENDLOOP_ENABLE_PREVIEW=false
